[0.116, "o", "\u001b[1;34musage: \u001b[0m\u001b[1;35mtmuxp import\u001b[0m [\u001b[32m-h\u001b[0m] \u001b[32m{teamocil,tmuxinator} ...\u001b[0m\r\n\r\nImport workspaces from teamocil and tmuxinator configuration files.\r\n\r\n\u001b[1;34mteamocil examples:\u001b[0m\r\n  \u001b[1;35mtmuxp\u001b[0m \u001b[1;32mimport\u001b[0m teamocil ~/.teamocil/project.yml\r\n\r\n\u001b[1;34mtmuxinator examples:\u001b[0m\r\n  \u001b[1;35mtmuxp\u001b[0m \u001b[1;32mimport\u001b[0m tmuxinator ~/.tmuxinator/project.yml\r\n\r\n\u001b[1;34moptions:\u001b[0m\r\n  \u001b[1;32m-h\u001b[0m, \u001b[1;36m--help\u001b[0m            show this help message and exit\r\n\r\n\u001b[1;34mcommands:\u001b[0m\r\n  valid commands\r\n\r\n  \u001b[1;32m{teamocil,tmuxinator}\u001b[0m\r\n                        additional help\r\n    \u001b[1;32mteamocil\u001b[0m            convert and import a teamocil config\r\n    \u001b[1;32mtmuxinator\u001b[0m          convert and import a tmuxinator config\r\n"]
